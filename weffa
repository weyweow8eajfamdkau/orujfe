local MAX = 1750000

local function fmt(n)
	local s = tostring(math.floor(n)):reverse()
	return "$" .. s:gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function getMoneyLabel()
	-- Try every likely path the game might use
	local function tryPath(...)
		local obj = playerGui
		for _, key in ipairs({...}) do
			obj = obj and obj:FindFirstChild(key)
		end
		return obj and obj:IsA("TextLabel") and obj or nil
	end

	return tryPath("PlayerUI", "ScreenGUI", "Money", "Amount")
		or tryPath("PlayerUI", "Money", "Amount")
		or (function()
			-- Deep search fallback: find any Frame named Money with an Amount child
			for _, desc in ipairs(playerGui:GetDescendants()) do
				if desc:IsA("Frame") and desc.Name == "Money" then
					local amt = desc:FindFirstChild("Amount")
					if amt and amt:IsA("TextLabel") then return amt end
				end
			end
		end)()
end

