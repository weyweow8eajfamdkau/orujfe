local MAX = 8000000

local function fmt(n)
	local s = tostring(math.floor(n)):reverse()
	return "$" .. s:gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
end

local function getMoneyLabels()
	local found = {}

	for _, desc in ipairs(playerGui:GetDescendants()) do
		if desc:IsA("TextLabel") then
			local n = desc.Name
			if n == "cashLabel" then
				table.insert(found, desc)
			elseif n == "ValueLabel" then
				local p = desc.Parent
				if p then
					local gp = p.Parent
					if gp and (gp.Name == "CashDisplay" or gp.Name == "UpdateDisplay") then
						table.insert(found, desc)
					end
				end
			end
		end
	end

	return found
end

local _overrideCancel = nil
local function applyMoneyDisplay(value)
	if _overrideCancel then
		_overrideCancel()
		_overrideCancel = nil
	end

	local formatted = fmt(value)
	local running = true

	_overrideCancel = function() running = false end

	local conn = playerGui.DescendantAdded:Connect(function(desc)
		if not running then return end
		if desc:IsA("TextLabel") then
			local n = desc.Name
			if n == "cashLabel" or n == "ValueLabel" then
				task.wait()
				if running then desc.Text = formatted end
			end
		end
	end)

	task.spawn(function()
		while running do
			local labels = getMoneyLabels()
			for _, lbl in ipairs(labels) do
				if lbl and lbl.Parent then
					lbl.Text = formatted
				end
			end
			task.wait(0.1)
		end
		conn:Disconnect()
	end)
end

