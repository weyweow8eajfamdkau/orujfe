local function scrollToBottom()
	local h = logList.AbsoluteContentSize.Y + 20
	logScroll.CanvasSize = UDim2.new(0, 0, 0, h)
	logScroll.CanvasPosition = Vector2.new(0, math.max(0, h - logScroll.AbsoluteSize.Y))
