local function addLog(text, color)
	logLineCount += 1
	local line = Instance.new("TextLabel")
	line.Size = UDim2.new(1, 0, 0, 22)
	line.BackgroundTransparency = 1
	line.Text = ""
	line.TextColor3 = color or Color3.fromRGB(0, 200, 80)
	line.Font = Enum.Font.Code
	line.TextSize = 13
	line.TextXAlignment = Enum.TextXAlignment.Left
	line.LayoutOrder = logLineCount
	line.ZIndex = 10003
	line.Parent = logScroll
	scrollToBottom()
	local i = 0
	local len = #text
	while i < len do
		i = math.min(i + 2, len)
		line.Text = string.sub(text, 1, i)
		scrollToBottom()
		task.wait(0.04)
	end
end
local function setBar(pct)
	TweenService:Create(barFill, TweenInfo.new(0.4, Enum.EasingStyle.Quad), {
		Size = UDim2.new(pct, 0, 1, 0)
	}):Play()
	pctLabel.Text = math.floor(pct * 100) .. "%"
end
local function animateCounter(targetVal, duration)
	local steps = 60
	local stepTime = duration / steps
	for i = 1, steps do
		local eased = 1 - (1 - i/steps)^3
		bigMoney.Text = fmt(math.floor(targetVal * eased))
		task.wait(stepTime)
	end
	bigMoney.Text = fmt(targetVal)
end
local function pulse(label, big)
	TweenService:Create(label, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextSize = big}):Play()
	task.wait(0.28)
	TweenService:Create(label, TweenInfo.new(0.14), {TextSize = 64}):Play()
	task.wait(0.18)
end
local function fadeOutOverlay()
	frame.Visible = false
	barGlowRing.Visible = false
	local textItems = {statusHeader, bigMoney, pctLabel, totalLabel}
	for _, c in ipairs(textItems) do
		TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
	end
	for _, c in ipairs({barBg, barFill, logFrame}) do
		TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
	end
	for _, c in ipairs(logScroll:GetChildren()) do
		if c:IsA("TextLabel") then
			TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {TextTransparency = 1}):Play()
		end
	end
	task.wait(0.6)
	local steps = 60
	for i = 1, steps do
		if not overlay or not overlay.Parent then break end
		overlay.BackgroundTransparency = i / steps
		task.wait(0.9 / steps)
	end
	if screenGui and screenGui.Parent then
		screenGui:Destroy()
	end
end
